    given-names: "Mario Barroso"
    orcid: "https://orcid.org/0000-0001-5890-0536"
    affiliation: "The Nature Conservancy, Brasilia, Brazil"
  - family-names: "Hofmann"
    given-names: "Gabriel Selbach"
    orcid: "https://orcid.org/0000-0003-2525-8537"
    affiliation: "Programa de Pos-Graduacao em Geografia, Universidade Federal do Rio Grande do Sul, Porto Alegre, RS, Brazil"
keywords:
  - fire
  - Brazilian biomes
  - Cerrado
  - Amazon
  - burned area
  - centroid
  - MapBiomas
  - spatial analysis
